      "uid": "acme-device:1",
      "raw_label": "1",
      "title": "Overview",
      "level": 1,
      "text": "The fictional Acme device exposes telemetry commands and a control register.",
      "page_start": 1,
      "page_end": 1
    },
    {
      "uid": "acme-device:2",
      "raw_label": "2",
      "title": "Commands",
      "level": 1,
      "text": "The fictional command set contains Read Telemetry.",
      "page_start": 2,
      "page_end": 2
    },
    {
      "uid": "acme-device:2.1",
      "raw_label": "2.1",
      "title": "Read Telemetry command",
      "level": 2,
      "parent_uid": "acme-device:2",
      "text": "Read Telemetry returns a fictional temperature sample. The command identifier is A1h.",
      "page_start": 2,
      "page_end": 2
    },
    {
      "uid": "acme-device:3",
      "raw_label": "3",
      "title": "Registers",
      "level": 1,
      "text": "The fictional register map contains CTRL.",
      "page_start": 3,
      "page_end": 3
    },
    {
      "uid": "acme-device:3.1",
      "raw_label": "3.1",
      "title": "CTRL register",
      "level": 2,
      "parent_uid": "acme-device:3",
      "text": "CTRL contains the EN enable bit at bit zero and the MODE field at bits two through one.",
      "page_start": 3,
      "page_end": 3
    }
  ],
